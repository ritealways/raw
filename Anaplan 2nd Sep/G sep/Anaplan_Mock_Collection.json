            "api",
            "2",
            "0",
            "workspaces",
            ":workspace_id",
            "models",
            ":model_id",
            "files",
            ":file_id",
            "upload"
          ],
          "variable": [
            {
              "key": "workspace_id",
              "value": "ws_mock_001"
            },
            {
              "key": "model_id",
              "value": "model_mock_101"
            },
            {
              "key": "file_id",
              "value": "processed_output"
            }
          ]
