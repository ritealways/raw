      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": ""
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/2/0/workspaces/:workspace_id/models/:model_id/files/:file_id/upload",
          "host": [
            "{{base_url}}"
          ],
