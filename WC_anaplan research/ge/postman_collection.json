{
  "info": {
    "name": "Anaplan Mock Server & ML Forecasting API",
    "_postman_id": "anaplan-mock-collection-v2",
    "description": "Collection to test Anaplan REST API v2.0 mock endpoints and ML forecast data integration.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "workspaceId",
      "value": "wrk-insurance-001",
      "type": "string"
    },
    {
      "key": "modelId",
      "value": "mod-wc-pricing-2026",
      "type": "string"
    },
    {
      "key": "viewId",
      "value": "view-input-wc-features",
      "type": "string"
    },
    {
      "key": "fileId",
      "value": "file-forecast-output-csv",
      "type": "string"
    },
    {
      "key": "processId",
      "value": "proc-import-forecasts",
      "type": "string"
    },
    {
      "key": "bearerToken",
      "value": "mock-oauth-token-abc123",
      "type": "string"
    },
    {
      "key": "taskId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication - Get OAuth Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.access_token) {",
              "    pm.collectionVariables.set('bearerToken', jsonData.access_token);",
              "    console.log('Saved bearerToken:', jsonData.access_token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "client_credentials",
              "type": "text"
            },
            {
              "key": "client_id",
              "value": "mock_anaplan_client",
              "type": "text"
            },
            {
              "key": "client_secret",
              "value": "mock_anaplan_secret",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/oauth2/token",
          "host": ["{{baseUrl}}"],
          "path": ["oauth2", "token"]
        }
      }
    },
    {
      "name": "2. Get Workspaces",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{bearerToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/2/0/workspaces",
          "host": ["{{baseUrl}}"],
          "path": ["api", "2", "0", "workspaces"]
        }
      }
    },
    {
      "name": "3. Get Models in Workspace",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{bearerToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/2/0/workspaces/{{workspaceId}}/models",
          "host": ["{{baseUrl}}"],
          "path": ["api", "2", "0", "workspaces", "{{workspaceId}}", "models"]
        }
      }
    },
    {
      "name": "4. Get Input Feature View Data (Excel Input)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{bearerToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/2/0/workspaces/{{workspaceId}}/models/{{modelId}}/views/{{viewId}}/data",
          "host": ["{{baseUrl}}"],
          "path": ["api", "2", "0", "workspaces", "{{workspaceId}}", "models", "{{modelId}}", "views", "{{viewId}}", "data"]
        }
      }
    },
    {
      "name": "5. Upload Forecasted Output Chunk (P10, P50, P90)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{bearerToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/octet-stream"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "Region,Channel,Industry Class,Account Size,Month,P10,P50 (Median),P90\nMid West,Agency,Agriculture,Large,Jan-2026,39850.0,36879.0,47557.0\nMid West,Agency,Agriculture,Large,Feb-2026,44207.0,34222.0,48144.0\nMid West,Agency,Agriculture,Large,Mar-2026,39483.0,36949.0,44309.0"
        },
        "url": {
          "raw": "{{baseUrl}}/api/2/0/workspaces/{{workspaceId}}/models/{{modelId}}/files/{{fileId}}/chunks/0",
          "host": ["{{baseUrl}}"],
          "path": ["api", "2", "0", "workspaces", "{{workspaceId}}", "models", "{{modelId}}", "files", "{{fileId}}", "chunks", "0"]
        }
      }
    },
    {
      "name": "6. Run Import Process Task",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.taskId) {",
              "    pm.collectionVariables.set('taskId', jsonData.taskId);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{bearerToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"localeName\": \"en_US\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/2/0/workspaces/{{workspaceId}}/models/{{modelId}}/processes/{{processId}}/tasks",
          "host": ["{{baseUrl}}"],
          "path": ["api", "2", "0", "workspaces", "{{workspaceId}}", "models", "{{modelId}}", "processes", "{{processId}}", "tasks"]
        }
      }
    },
    {
      "name": "7. Check Import Task Status",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{bearerToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/2/0/workspaces/{{workspaceId}}/models/{{modelId}}/tasks/{{taskId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "2", "0", "workspaces", "{{workspaceId}}", "models", "{{modelId}}", "tasks", "{{taskId}}"]
        }
      }
    },
    {
      "name": "8. Inspect Anaplan Final Forecasted Output Grid",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{bearerToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/2/0/workspaces/{{workspaceId}}/models/{{modelId}}/forecast-output",
          "host": ["{{baseUrl}}"],
          "path": ["api", "2", "0", "workspaces", "{{workspaceId}}", "models", "{{modelId}}", "forecast-output"]
        }
      }
    }
  ]
}