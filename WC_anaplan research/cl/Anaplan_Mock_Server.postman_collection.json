{
  "info": {
    "name": "Anaplan Mock Server",
    "description": "Test collection for the local mock Anaplan API used with wc_lightgbm_forecast.py. Run requests top to bottom.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "token", "value": "" },
    { "key": "workspace_id", "value": "wrk-001" },
    { "key": "model_id", "value": "mod-101" },
    { "key": "input_file_id", "value": "file-201" },
    { "key": "output_file_id", "value": "file-202" },
    { "key": "process_id", "value": "proc-301" },
    { "key": "task_id", "value": "" }
  ],
  "item": [
    {
      "name": "1. Health Check",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/"
      }
    },
    {
      "name": "2. Login (get token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "pm.collectionVariables.set('token', data.access_token);",
              "console.log('Saved token:', data.access_token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{base_url}}/oauth2/token",
        "header": [
          { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "grant_type", "value": "client_credentials" },
            { "key": "client_id", "value": "demo-client" },
            { "key": "client_secret", "value": "demo-secret" }
          ]
        }
      }
    },
    {
      "name": "3. List Workspaces",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/2/0/workspaces",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ]
      }
    },
    {
      "name": "4. List Models",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/2/0/workspaces/{{workspace_id}}/models",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ]
      }
    },
    {
      "name": "5. List Files",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/2/0/workspaces/{{workspace_id}}/models/{{model_id}}/files",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ]
      }
    },
    {
      "name": "6. Download Input Data (Export)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/2/0/workspaces/{{workspace_id}}/models/{{model_id}}/files/{{input_file_id}}",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ]
      }
    },
    {
      "name": "7. Upload Forecast Chunk (Import step 1)",
      "request": {
        "method": "PUT",
        "url": "{{base_url}}/api/2/0/workspaces/{{workspace_id}}/models/{{model_id}}/files/{{output_file_id}}/chunks/0",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "text/csv" }
        ],
        "body": {
          "mode": "raw",
          "raw": "Region,Channel,Industry_Class,Account_Size,Month,P10,P50_Median,P90\nMid West,Agency,Agriculture,Large,2026-01-01,39850,36879,47557\nMid West,Agency,Agriculture,Large,2026-02-01,44207,34222,48144\nMid West,Agency,Agriculture,Large,2026-03-01,39483,36949,44309\n"
        }
      }
    },
    {
      "name": "8. Run Import Process (Import step 2)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "pm.collectionVariables.set('task_id', data.taskId);",
              "console.log('Saved task_id:', data.taskId);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/2/0/workspaces/{{workspace_id}}/models/{{model_id}}/processes/{{process_id}}/tasks",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ]
      }
    },
    {
      "name": "9. Check Task Status",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/2/0/workspaces/{{workspace_id}}/models/{{model_id}}/tasks/{{task_id}}",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ]
      }
    },
    {
      "name": "10. Download Forecast Output (Verify)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/2/0/workspaces/{{workspace_id}}/models/{{model_id}}/files/{{output_file_id}}",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ]
      }
    }
  ]
}
