{
  "info": {
    "name": "Mock Anaplan",
    "description": "Test collection to simulate pulling data from Anaplan and pushing forecast results back.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Server Status",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/anaplan/status",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["anaplan", "status"]
        }
      }
    },
    {
      "name": "2. Upload Input Data (simulate Anaplan has data)",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": []
            }
          ]
        },
        "url": {
          "raw": "http://localhost:5000/anaplan/upload-input",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["anaplan", "upload-input"]
        }
      }
    },
    {
      "name": "3. Get Input Data (export FROM Anaplan)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/anaplan/get-input",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["anaplan", "get-input"]
        }
      }
    },
    {
      "name": "4. Push Output Data (push forecast INTO Anaplan)",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": []
            }
          ]
        },
        "url": {
          "raw": "http://localhost:5000/anaplan/push-output",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["anaplan", "push-output"]
        }
      }
    },
    {
      "name": "5. Get Output Data (verify forecast received)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/anaplan/get-output",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["anaplan", "get-output"]
        }
      }
    }
  ]
}
