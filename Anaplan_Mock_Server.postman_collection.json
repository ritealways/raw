{
  "info": {
    "name": "Anaplan Mock Server",
    "description": "Test collection for the local mock Anaplan API used with pipeline.py + wc_lgbm.py. Run requests top to bottom.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "token", "value": "" },
    { "key": "workspace_id", "value": "wrk-001" },
    { "key": "model_id", "value": "mod-101" },
    { "key": "input_file_id", "value": "file-201" },
    { "key": "output_file_id", "value": "file-202" },
    { "key": "process_id", "value": "proc-301" },
    { "key": "task_id", "value": "" }
  ],
  "item": [
    {
      "name": "1. Health Check",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/"
      },
      "response": []
    },
    {
      "name": "2. Login (get token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "pm.collectionVariables.set('token', data.access_token);",
              "console.log('Saved token:', data.access_token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{base_url}}/oauth2/token"
      },
      "response": []
    },
    {
      "name": "3. List Workspaces",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/2/0/workspaces",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ]
      },
      "response": []
    },
    {
      "name": "4. List Models",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/2/0/workspaces/{{workspace_id}}/models",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ]
      },
      "response": []
    },
    {
      "name": "5. List Files",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/2/0/workspaces/{{workspace_id}}/models/{{model_id}}/files",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ]
      },
      "response": []
    },
    {
      "name": "6. Download input_excel.xlsx (Export)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/2/0/workspaces/{{workspace_id}}/models/{{model_id}}/files/{{input_file_id}}",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ]
      },
      "response": []
    },
    {
      "name": "7. Upload Output_excel.xlsx (Import step 1)",
      "request": {
        "method": "PUT",
        "url": "{{base_url}}/api/2/0/workspaces/{{workspace_id}}/models/{{model_id}}/files/{{output_file_id}}/chunks/0",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "file",
          "file": {
            "src": ""
          }
        },
        "description": "IMPORTANT: click the 'Body' tab, choose 'binary', then click 'Select File' and pick your real Output_excel.xlsx (the file wc_lgbm.py produced) from your computer."
      },
      "response": []
    },
    {
      "name": "8. Run Import Process (Import step 2)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "pm.collectionVariables.set('task_id', data.taskId);",
              "console.log('Saved task_id:', data.taskId);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/2/0/workspaces/{{workspace_id}}/models/{{model_id}}/processes/{{process_id}}/tasks",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ]
      },
      "response": []
    },
    {
      "name": "9. Check Task Status",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/2/0/workspaces/{{workspace_id}}/models/{{model_id}}/tasks/{{task_id}}",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ]
      },
      "response": []
    },
    {
      "name": "10. Download Output_excel.xlsx (Verify)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/2/0/workspaces/{{workspace_id}}/models/{{model_id}}/files/{{output_file_id}}",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ]
      },
      "response": []
    }
  ]
}
